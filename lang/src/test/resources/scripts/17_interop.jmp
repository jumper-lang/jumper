// Interop with real Java APIs: overloads, varargs, enums, nested classes, arrays, functional interfaces
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

// --- overloads are chosen by argument types
assert(Math.max(3, 7) == 7 && Math.max(3.5, 2.0) == 3.5 && Math.max(3L, 9L) == 9L);
assert(Math.abs(-4) == 4 && Math.abs(-4.5) == 4.5);
assert(String.valueOf(42) == "42" && String.valueOf(true) == "true");
dyn sb = new java.lang.StringBuilder();
sb.append(1).append("x").append(2.5).append(true);
assert(sb.toString() == "1x2.5true");
dyn l = new ArrayList(List.of(10, 20, 30));
l.remove(1);                                  // remove(int index), as in Java
assert(str(l) == "[10, 30]");

// --- varargs: one by one and as an array (the array is "spread", as in Java)
assert(String.format("%s-%d", "a", 7) == "a-7");
// %.2f depends on the JVM locale (in ru_RU it is "1,50") - use the overload with Locale:
// this also checks overload selection where a regular parameter precedes the varargs
assert(String.format(java.util.Locale.ROOT, "%s-%d-%.2f", "a", 7, 1.5) == "a-7-1.50");
assert(String.join(",", "a", "b") == "a,b" && String.join("-", ["x", "y"]) == "x-y");
assert(List.of(1, 2, 3).size() == 3 && Arrays.asList(["a", "b"]).size() == 2);
assert(String.format("no args") == "no args");

// --- enum: constants, methods, comparison, values()
dyn mon = java.time.DayOfWeek.MONDAY;
assert(mon == java.time.DayOfWeek.MONDAY && mon.name() == "MONDAY" && mon.getValue() == 1);
assert(java.time.DayOfWeek.valueOf("FRIDAY").ordinal() == 4 && len(java.time.DayOfWeek.values()) == 7);
assert(java.util.concurrent.TimeUnit.SECONDS.toMillis(2) == 2000L);
assert(str(new java.math.BigDecimal("2.345").setScale(2, java.math.RoundingMode.HALF_UP)) == "2.35");

// --- nested classes and static factories
dyn e = java.util.Map.entry("k", 5);
assert(e.getKey() == "k" && e.getValue() == 5);
assert(new java.util.AbstractMap.SimpleEntry("a", 1).getValue() == 1);
dyn lm = new java.util.LinkedHashMap();
lm.put("x", 1); lm.put("y", 2);
dyn keys = "";
for (dyn en : lm.entrySet()) keys += en.getKey();
assert(keys == "xy" && lm.size() == 2);

// --- real Java arrays: creation, length, indexing, iteration, passing to Java
dyn ia = new int[4];
ia[0] = 5; ia[3] = 7;
assert(len(ia) == 4 && ia.length == 4 && ia[0] == 5 && type(ia) == "int[]");
assert(Arrays.stream(ia).sum() == 12);
dyn da = new double[]{1.5, 2.5};
assert(da.length == 2 && da[1] == 2.5 && type(da) == "double[]");
dyn sa = new String[]{"a", "b"};
assert(String.join("", sa) == "ab" && type(sa) == "String[]");
dyn sum = 0;
for (dyn x : ia) sum += x;
assert(sum == 12);
assert(Arrays.toString([3, 1, 2]) == "[3, 1, 2]");   // a script array is converted to a Java array
assert(Arrays.stream([1, 2, 3]).sum() == 6);
assert(len("a,b,c".split(",")) == 3);                // a Java array as a result

// --- Class objects
assert(java.lang.String.class == "s".getClass() && type(java.lang.String.class) == "java.lang.Class");
assert(String.class.getSimpleName() == "String");

// --- functional interfaces from script functions
dyn names = new ArrayList(List.of("bb", "a", "ccc"));
names.sort((a, b) -> len(a) - len(b));
assert(str(names) == "[a, bb, ccc]");
assert(List.of(3, 1, 2).stream().map(x -> x * 2).filter(x -> x > 2).count() == 2L);
assert(List.of(1, 2, 3).stream().mapToInt(x -> x).sum() == 6);
assert(List.of("a", "b").stream().collect(java.util.stream.Collectors.joining("+")) == "a+b");
dyn ran = [0];
dyn t = new java.lang.Thread(() -> ran[0] = 1);
t.start(); t.join();
assert(ran[0] == 1);

// --- public fields of Java objects and static fields
dyn pt = new java.awt.Point(1, 2);
pt.x = 10;
assert(pt.x == 10 && pt.getX() == 10.0);
assert(java.lang.Integer.MAX_VALUE == 2147483647 && Math.PI > 3.14);

// --- Java exceptions are caught by a regular catch
dyn caught = "";
try { java.lang.Integer.parseInt("zz"); } catch (ex) { caught = type(ex); }
assert(caught == "java.lang.NumberFormatException", caught);
// a script class cannot extend a Java class - a clear error
println("17_interop OK");
