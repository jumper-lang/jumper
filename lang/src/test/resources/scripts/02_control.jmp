dyn sum = 0;
for (int i = 0; i < 10; i++) { if (i % 2 == 0) continue; sum += i; }
assert(sum == 25);

dyn i = 0;
while (true) { i++; if (i == 7) break; }
assert(i == 7);

dyn k = 0;
do { k++; } while (k < 3);
assert(k == 3);

dyn acc = "";
for (dyn v : [1, 2, 3]) acc = acc + v;
assert(acc == "123");

dyn keys = "";
dyn tbl = { a: 1, b: 2, c: 3 };
for (dyn key : tbl) keys = keys + key;
assert(keys == "abc", "insertion order");

dyn chars = 0;
for (dyn ch : "abc") chars++;
assert(chars == 3);

// nested loops with break
dyn found = null;
for (int a = 0; a < 10; a++) {
    for (int b = 0; b < 10; b++) {
        if (a * b == 42) { found = [a, b]; break; }
    }
    if (found != null) break;
}
assert(found[0] == 6 && found[1] == 7);

// else if
dyn sign(x) {
    if (x > 0) return 1;
    else if (x < 0) return -1;
    else return 0;
}
assert(sign(5) == 1 && sign(-3) == -1 && sign(0) == 0);

// return from the middle of a loop
dyn firstEven(arr) { for (dyn v : arr) if (v % 2 == 0) return v; return null; }
assert(firstEven([1, 3, 4, 5]) == 4 && firstEven([1]) == null);

// block scope
dyn shadow = 1;
{ dyn shadow2 = 2; assert(shadow + shadow2 == 3); }
for (int j = 0; j < 1; j++) { dyn inner = j; }
assert(range(5).length == 5 && range(2, 10, 3)[2] == 8);
println("02_control OK");
