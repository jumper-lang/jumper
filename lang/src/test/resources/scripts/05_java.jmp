import java.util.ArrayList;
import java.util.HashMap;
import java.util.Arrays;

dyn list = new ArrayList();
list.add("a"); list.add("b"); list.add("c");
assert(list.size() == 3 && list.get(1) == "b" && list[2] == "c");
dyn joined = "";
for (dyn s : list) joined += s;
assert(joined == "abc");

dyn map = new HashMap();
map.put("k", 1);
map["j"] = 2;
assert(map.get("k") == 1 && map["j"] == 2 && map.size() == 2);
assert(map.getOrDefault("zzz", 7) == 7);

// static methods and fields
assert(Math.max(3, 7) == 7 && Math.abs(-2.5) == 2.5 && Math.PI > 3.14);
assert(Math.sqrt(16) == 4.0);
assert(Integer.MAX_VALUE == 2147483647);
assert(Integer.parseInt("12") == 12);
assert(Long.MAX_VALUE > 0);
assert(String.valueOf(42) == "42");
assert(String.join("-", "a", "b", "c") == "a-b-c", "varargs");

// a string is a java.lang.String
assert("hello".toUpperCase() == "HELLO");
assert("a,b,c".split(",").length == 3);
assert("hello".substring(1, 3) == "el");
assert("hello".charAt(1) == 'e');
assert("  x ".trim() == "x");
assert("hello".length == 5 && "hello".length() == 5);
assert("hello".indexOf("l") == 2);
assert("x".repeat(3) == "xxx");

// Java array
dyn parts = "1 2 3".split(" ");
dyn total = 0;
for (dyn p : parts) total += Integer.parseInt(p);
assert(total == 6);
assert(parts[0] == "1");

// functional interfaces: Jumper function -> Java lambda
dyn nums = new ArrayList();
nums.add(3); nums.add(1); nums.add(2);
nums.sort((a, b) -> a - b);
assert(nums.get(0) == 1 && nums.get(2) == 3);
nums.removeIf(v -> v == 2);
assert(nums.size() == 2);
dyn sb = new StringBuilder();
nums.forEach(v -> sb.append(v));
assert(sb.toString() == "13");

// fully qualified name without import
dyn tm = new java.util.TreeMap();
tm.put("b", 1); tm.put("a", 2);
assert(tm.firstKey() == "a");

// properties via getters
dyn th = Thread.currentThread();
assert(th.name == th.getName());

// System
assert(System.currentTimeMillis() > 0 && nanoTime() > 0 && millis() > 0);
assert(Arrays.asList("x", "y").size() == 2);
println("05_java OK");
